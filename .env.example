# Public browser configuration. Never use a service_role / secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional public request form. Without these, internet submissions are disabled.
# Public Turnstile site key (not the secret).
VITE_TURNSTILE_SITE_KEY=
# Canonical app origin; configure separately for each deployment environment.
PUBLIC_SITE_URL=https://reposita-1s1q.vercel.app
# Server-only Vercel Secret variables. NEVER add VITE_ to these names.
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=

# Monthly subscriptions. Server-only Vercel Secret; test first, then live.
# Native Stripe integration may provision it. Never prefix with VITE_.
STRIPE_SECRET_KEY=
# Webhook secret and Stripe price IDs are generated by the owner setup screen
# and stored in private Supabase tables, never in the browser.
